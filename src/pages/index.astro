import BaseLayout from '../layouts/BaseLayout.astro';

const faqJsonLd = `{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is FSM Dispatch by Avishkar AI?","acceptedAnswer":{"@type":"Answer","text":"FSM Dispatch is an AI-native uptime layer specifically built for critical infrastructure like ATMs, telecom towers, and HVAC systems. It automates the entire triage and dispatch lifecycle to prevent catastrophic downtime."}},{"@type":"Question","name":"How much of the dispatching is truly autonomous?","acceptedAnswer":{"@type":"Answer","text":"Our platform operates on a 90% AI and 10% human oversight model. 90% of all dispatch decisions—including triage, severity matching, and engineer assignment—are handled autonomously by the system."}},{"@type":"Question","name":"Is this solution battle-tested in the field?","acceptedAnswer":{"@type":"Answer","text":"Yes. We are currently live in production managing 15,000+ ATMs and 68,000+ telecom towers across India and South Asia for top-tier providers. This is a revenue-generating production deployment, not a pilot."}},{"@type":"Question","name":"Can FSM Dispatch integrate with our existing NOC or SCADA?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. FSM Dispatch is infrastructure-native and integrates anywhere, working seamlessly with SCADA, BMS, NMS, and proprietary enterprise NOC tools without requiring software migrations."}},{"@type":"Question","name":"How does the pricing model work?","acceptedAnswer":{"@type":"Answer","text":"We use an outcome-based, per-asset per-month subscription model. This aligns our success directly with yours, as our revenue grows based on the number of assets we keep online."}},{"@type":"Question","name":"What specific asset categories do you support?","acceptedAnswer":{"@type":"Answer","text":"While we specialize in ATMs and Telecom Towers, the platform is built for any high-value critical asset, including industrial HVAC, medical equipment, and cinema infrastructure."}},{"@type":"Question","name":"What happens when a critical alert fires?","acceptedAnswer":{"@type":"Answer","text":"The AI instantly ingests the alert, triages the severity, matches it to the right engineer based on proximity and skill, dispatches the job with full context, and tracks the resolution through to closure."}},{"@type":"Question","name":"How do you guarantee accountability?","acceptedAnswer":{"@type":"Answer","text":"Accountability is baked into our model. We align our performance with your business goals by requiring assets to maintain a 95%+ uptime SLA to ensure operational success."}}]}`;
