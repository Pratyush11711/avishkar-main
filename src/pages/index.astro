<g class="protocol-svg-labels" text-anchor="middle"><text x="100" y="106">SCADA</text><text x="100" y="206">NOC</text><text x="100" y="306">BMS</text><text x="532" y="206">Severity triage</text></g>
<circle cx="340" cy="200" r="38" class="protocol-core"/><path d="M329 200L337 208L353 190" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
